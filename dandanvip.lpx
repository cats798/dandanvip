#!name=蛋蛋不语VIP解锁 v2（新版 1.0.2）
#!desc=适配新版 supabase.opengl.top 端点 + get_my_vip_access RPC
#!author=Curtinp118 / v2 by RNA
#!homepage=https://github.com/cats798/dandanvip

# 直接导入本链接即可，脚本自动从 raw 拉取。
# 需在 Loon 开启 MITM 并安装证书，否则 HTTPS 响应拿不到明文。

[Rule]
# 旧版规则保留（备用 IP 回落时仍生效）
DOMAIN-SUFFIX,one.one.one.one
DOMAIN-SUFFIX,api.wwzy.tv
DOMAIN-SUFFIX,bfzyapi.com
DOMAIN-SUFFIX,img.picbf.com
DOMAIN-SUFFIX,v10.baofeng10.com
DOMAIN-SUFFIX,icanhazip.com
DOMAIN-SUFFIX,captive.apple.com
DOMAIN-SUFFIX,ajax.googleapis.com
DOMAIN-SUFFIX,s1.fengbao9.com
DOMAIN-SUFFIX,develop202.github.io
DOMAIN-SUFFIX,s2.bfllvip.com
IP-CIDR,38.76.202.248/32
# 新版主端点
DOMAIN-SUFFIX,opengl.top

[Script]
# ===== 新版主端点：profiles 表 =====
http-response ^https?:\/\/supabase\.opengl\.top\/rest\/v1\/profiles.* script-path=https://raw.githubusercontent.com/cats798/dandanvip/main/dandanvip_unlock_v2.js, requires-body=true, timeout=10, tag=蛋蛋不语VIP-profiles, enable=true

# ===== 新版主端点：VIP 裁决 RPC（两种可能的入口） =====
http-response ^https?:\/\/supabase\.opengl\.top\/rest\/v1\/rpc\/get_my_vip_access.* script-path=https://raw.githubusercontent.com/cats798/dandanvip/main/dandanvip_unlock_v2.js, requires-body=true, timeout=10, tag=蛋蛋不语VIP-rpc, enable=true
http-response ^https?:\/\/supabase\.opengl\.top\/functions\/v1\/get_my_vip_access.* script-path=https://raw.githubusercontent.com/cats798/dandanvip/main/dandanvip_unlock_v2.js, requires-body=true, timeout=10, tag=蛋蛋不语VIP-edge, enable=true

# ===== 旧版备用 IP：profiles（明文回落时兜底） =====
http-response ^http:\/\/38\.76\.202\.248:8000\/.*profiles.* script-path=https://raw.githubusercontent.com/cats798/dandanvip/main/dandanvip_unlock_v2.js, requires-body=true, timeout=10, tag=蛋蛋不语VIP-old, enable=true

[MITM]
hostname = supabase.opengl.top, 38.76.202.248
