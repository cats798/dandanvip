#!name=蛋蛋不语VIP解锁 v3
#!desc=按抓包修正：真实路径为 //rest/v1/（双斜杠），打 profiles + config
#!author=RNA
#!homepage=https://github.com/cats798/dandanvip

# 直接导入本链接即可，脚本自动从 raw 拉取。
# 必须开启 MITM 并安装证书。

[Rule]
DOMAIN-SUFFIX,one.one.one.one
DOMAIN-SUFFIX,api.wwzy.tv
DOMAIN-SUFFIX,bfzyapi.com
DOMAIN-SUFFIX,img.picbf.com
DOMAIN-SUFFIX,v10.baofeng10.com
DOMAIN-SUFFIX,icanhazip.com
DOMAIN-SUFFIX,captive.apple.com
DOMAIN-SUFFIX,ajax.googleapis.com
DOMAIN-SUFFIX,s1.fengbao9.com
DOMAIN-SUFFIX,develop202.github.io
DOMAIN-SUFFIX,s2.bfllvip.com
IP-CIDR,38.76.202.248/32
DOMAIN-SUFFIX,opengl.top

[Script]
# ===== 用户资料：VIP 字段（注意 // 双斜杠，用 \/+ 兼容） =====
http-response ^https?:\/\/supabase\.opengl\.top\/+rest\/v1\/profiles.* script-path=https://raw.githubusercontent.com/cats798/dandanvip/main/dandanvip_unlock_v3.js, requires-body=true, timeout=10, tag=蛋蛋不语VIP-profiles, enable=true

# ===== 全局 VIP 开关 =====
http-response ^https?:\/\/supabase\.opengl\.top\/+rest\/v1\/config.* script-path=https://raw.githubusercontent.com/cats798/dandanvip/main/dandanvip_unlock_v3.js, requires-body=true, timeout=10, tag=蛋蛋不语VIP-config, enable=true

# ===== 旧版备用 IP（明文回落兜底） =====
http-response ^http:\/\/38\.76\.202\.248:8000\/+rest\/v1\/profiles.* script-path=https://raw.githubusercontent.com/cats798/dandanvip/main/dandanvip_unlock_v3.js, requires-body=true, timeout=10, tag=蛋蛋不语VIP-old, enable=true

[MITM]
hostname = supabase.opengl.top, 38.76.202.248
