#!name=蛋蛋不语VIP解锁
#!desc=v4 最终版 — 按抓包钉死 vip_status/vip_level/vip_expire_at，兼容 //rest 双斜杠
#!author=RNA
#!homepage=https://github.com/cats798/dandanvip

# 直接导入本链接即可。必须开启 MITM 并安装证书。
# 注意：请删除其他所有"蛋蛋"相关插件，只留这一个，避免多脚本争抢 $done。

[Rule]
DOMAIN-SUFFIX,one.one.one.one
DOMAIN-SUFFIX,api.wwzy.tv
DOMAIN-SUFFIX,bfzyapi.com
DOMAIN-SUFFIX,img.picbf.com
DOMAIN-SUFFIX,v10.baofeng10.com
DOMAIN-SUFFIX,icanhazip.com
DOMAIN-SUFFIX,captive.apple.com
DOMAIN-SUFFIX,ajax.googleapis.com
DOMAIN-SUFFIX,s1.fengbao9.com
DOMAIN-SUFFIX,develop202.github.io
DOMAIN-SUFFIX,s2.bfllvip.com
IP-CIDR,38.76.202.248/32
DOMAIN-SUFFIX,opengl.top

[Script]
# 用户资料 VIP 字段（真实路径 //rest/v1/，用 \/+ 兼容）
http-response ^https?:\/\/supabase\.opengl\.top\/+rest\/v1\/profiles.* script-path=https://raw.githubusercontent.com/cats798/dandanvip/main/dandanvip_unlock_v4.js, requires-body=true, timeout=10, tag=蛋蛋VIP-profiles, enable=true

# 全局 VIP 开关
http-response ^https?:\/\/supabase\.opengl\.top\/+rest\/v1\/config.* script-path=https://raw.githubusercontent.com/cats798/dandanvip/main/dandanvip_unlock_v4.js, requires-body=true, timeout=10, tag=蛋蛋VIP-config, enable=true

# 旧版备用 IP 兜底
http-response ^http:\/\/38\.76\.202\.248:8000\/+rest\/v1\/profiles.* script-path=https://raw.githubusercontent.com/cats798/dandanvip/main/dandanvip_unlock_v4.js, requires-body=true, timeout=10, tag=蛋蛋VIP-old, enable=true

[MITM]
hostname = supabase.opengl.top, 38.76.202.248
